# DJI GroundStation -- copy to .env (scripts/bootstrap.sh does this and fills the secrets).

# Which optional parts to run (comma-separated):
#   archive  media + flight-log archive     ros    ROS 2 fleet bridge
#   dvm      Drone Video Measure            agro   QGIS + SDU Agro Tools + Agro API
#   odm      NodeODM orthomosaics           qgc    QGroundControl in the browser
#   tools / android: one-shot, use `docker compose run`
COMPOSE_PROFILES=archive,ros,dvm,agro,odm,qgc

# --- Login for every web UI (Caddy basic auth) ---------------------------------------------
GS_AUTH_USER=admin
# bcrypt hash, created by scripts/gen-password.sh. Escape every "$" as "$$" in this file.
GS_AUTH_HASH=

# --- TLS -----------------------------------------------------------------------------------
# internal: Caddy's own CA (download https://<host>/ca.crt once per device and trust it)
# acme:     Let's Encrypt; needs a public DNS name in GS_SITE_HOST and GS_ACME_EMAIL
GS_TLS=internal
GS_SITE_HOST=
GS_ACME_EMAIL=

# --- Public ports (Caddy) ----------------------------------------------------------------
GS_PORT_HTTP=80
GS_PORT_PORTAL=443
GS_PORT_DASHBOARD=8443
GS_PORT_DVM=5443
GS_PORT_QGIS=6443
GS_PORT_QGC=4443
GS_PORT_AGRO=7443
GS_PORT_ODM=3443
GS_PORT_FILES=9443

# --- Data ----------------------------------------------------------------------------------
# Shared archive: media/<drone>/, flightlogs/<drone>/, flightlogs/tlog/, orthomosaics/,
# agro-jobs/, apk/, logs/. Mounted as /data in media-sync, QGIS, Agro API, gs-tools.
GS_DATA_DIR=./data

# --- Video (MediaMTX) ----------------------------------------------------------------------
# true: anyone on the LAN may read RTSP/WebRTC streams (required for QGroundControl's automatic
#       video, which carries no credentials). false: LAN viewers need MTX_READ_USER/PASS.
MTX_LAN_READ_ANONYMOUS=true
MTX_READ_USER=viewer
MTX_READ_PASS=
# Field Wi-Fi interface(s) to advertise for WebRTC, e.g. wlan0 (empty = all interfaces)
MTX_WEBRTC_INTERFACES=
MTX_WEBRTC_ADDITIONAL_HOSTS=
MTX_WEBRTC_UDP_PORT=8189

# --- MAVLink (mavlink-router) --------------------------------------------------------------
MAVLINK_DRONE_PORT=14550
MAVLINK_TCP_PORT=5760
MAVLINK_LOG_ENABLED=true
# optional extra UDP ground station, host:port (e.g. a QGC laptop over VPN)
MAVLINK_EXTRA_UDP_TARGET=

# --- Lyrebird dashboard --------------------------------------------------------------------
# Optional fixed names / fallback IPs when broadcast discovery cannot reach the aircraft.
DRONE_NAMES=
DRONE_FALLBACKS=
DISCOVERY_INTERVAL_MS=5000

# --- Archive (media-sync) ------------------------------------------------------------------
MEDIA_SYNC_DOWNLOAD_MEDIA=true
MEDIA_SYNC_RECORD_TELEMETRY=true
MEDIA_SYNC_LANDED_SECONDS=60
# aircraft that broadcast discovery cannot reach: name=ip,name2=ip
MEDIA_SYNC_DRONES=

# --- ROS 2 ---------------------------------------------------------------------------------
ROS_DISTRO=lyrical
ROS_DOMAIN_ID=0

# --- DVM / QGIS / Agro / ODM ---------------------------------------------------------------
DVM_VERSION=v2.1.0
QGIS_VERSION=3.44
QGIS_GEOMETRY=1920x1080
# QGroundControl (profile qgc): official AppImage. Another release needs ALL of: version, the SHA-256 of both
# AppImages (GitHub release "digest") and QGC_SETTINGS_VERSION from that release's CMakeLists.txt – else the build
# fails at the checksum, or QGC wipes its settings on start.
QGC_VERSION=v5.1.5
QGC_SHA256_AMD64=9a47e4cf269d9e4f897f582f6b19aa7ebf1e9e67c9d68a532a45b541354bc344
QGC_SHA256_ARM64=ddd92fe3a1cd1c1c21a3028052e9f9b4d4a68cb80689552d3f34727ed2c91e03
QGC_SETTINGS_VERSION=9
QGC_GEOMETRY=1920x1080
# MAVLink system ID of QGC; the Lyrebird dashboard and ROS bridge send as 255 (MAVLink guide: GCS IDs count down
# from 255), so QGC uses 254 to stay distinguishable. A value changed later inside QGC is kept.
QGC_SYSTEM_ID=254
AGRO_MAX_PARALLEL_JOBS=1
AGRO_MAX_UPLOAD_MB=20480
NODEODM_VERSION=3.6.2
NODEODM_MAX_CONCURRENCY=4

# --- Android build (profile android) -------------------------------------------------------
# Your DJI developer app key for package com.lyrebird.rc (developer.dji.com -> Apps).
AIRCRAFT_API_KEY=
MAPLIBRE_TOKEN=dummy

# --- Safety (gs-tools signing tests) -------------------------------------------------------
# 64 hex chars, must match lb_mav_0_signing_key on the aircraft. Leave empty if unused.
LB_MAVLINK_SIGNING_KEY=
